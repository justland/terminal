{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.*.json", "src/**/*.{ts,tsx}"],
			"outputs": ["lib/**", "*.tsbuildinfo"]
		},
		"clean": { "cache": false },
		"coverage": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.*.json", "vitest.config.*", "src/**/*.{ts,tsx}"],
			"outputs": ["coverage/**"]
		},
		"depcheck": {
			"inputs": ["package.json", ".depcheckrc.*", "src/**/*.{ts,tsx}"]
		},
		"nuke": { "cache": false },
		"size": {
			"dependsOn": ["build"],
			"inputs": [".size-limit.json", "lib/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["package.json", "tsconfig.*.json", "vitest.config.*", "src/**/*.{ts,tsx}"]
		}
	}
}
