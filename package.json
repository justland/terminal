{
	"private": true,
	"description": "Just Web Terminal Repository",
	"scripts": {
		"ansi": "pnpm --filter ./logics/ansi",
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"size": "turbo run size",
		"terminal": "pnpm --filter ./logics/terminal",
		"test": "turbo run test",
		"verify": "run-p check verify:pkg",
		"verify:pkg": "turbo run build coverage depcheck size",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.12"
	},
	"packageManager": "pnpm@11.1.3"
}
