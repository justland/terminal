{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": ["!**/.turbo", "!**/coverage", "!**/lib", "!**/node_modules", "!pnpm-lock.yaml", "!skills-lock.json"]
	},
	"linter": {
		"rules": {
			"style": {
				"useNodejsImportProtocol": "error"
			}
		}
	},
	"javascript": {
		"formatter": { "trailingCommas": "none" }
	}
}
