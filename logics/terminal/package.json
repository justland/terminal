{
  "name": "@just-web/terminal",
  "version": "0.0.0",
  "homepage": "https://github.com/justland/terminal/tree/main/logics/terminal",
  "bugs": {
    "url": "https://github.com/justland/terminal/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justland/terminal.git",
    "directory": "logics/terminal"
  },
  "license": "MIT",
  "author": {
    "name": "Homa Wong (unional)",
    "email": "homawong@gmail.com",
    "url": "https://github.com/unional"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "ts",
    "!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf coverage lib --glob *.tsbuildinfo",
    "coverage": "jest --coverage",
    "depcheck": "depcheck",
    "lint": "eslint .",
    "nuke": "run-s clean nuke:local",
    "nuke:local": "rimraf node_modules",
    "size": "size-limit",
    "test": "jest",
    "verify": "npm-run-all -p lint depcheck build coverage -p size",
    "w": "jest --watch"
  },
  "devDependencies": {
    "@jest/globals": "^29.6.4",
    "@repobuddy/jest": "^3.4.0",
    "@types/node": "^25.9.0",
    "@repobuddy/typescript": "^1.2.0",
    "@size-limit/esbuild": "^8.2.6",
    "@size-limit/preset-small-lib": "^8.2.0",
    "depcheck": "^1.4.3",
    "jest": "^29.6.4",
    "jest-watch-suspend": "^1.1.2",
    "jest-watch-toggle-config-2": "^2.1.0",
    "jest-watch-typeahead": "^2.2.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.0",
    "size-limit": "^8.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  }
}