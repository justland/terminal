	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"files": [
		"lib",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rimraf coverage lib --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean nuke:local",
		"nuke:local": "rimraf node_modules",
		"size": "size-limit",
		"test": "vitest run",
		"w": "vitest"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.1.0",
		"@size-limit/esbuild": "^13.0.3",
		"@size-limit/preset-small-lib": "^13.0.3",
		"@types/node": "^25.9.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"size-limit": "^13.0.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
